rules_version = '2';

// Chặn toàn bộ đọc/ghi trực tiếp từ client, giữ đúng nguyên tắc của bản gốc
// (Code.gs): server luôn xác thực PIN + tự tính lại số liệu, client không bao giờ
// được tin. Mọi đọc/ghi phải đi qua Cloud Functions (dùng Admin SDK, bỏ qua rules này).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
